# =============================================================================
# CONMEL — Backend — variáveis de ambiente
# =============================================================================
# Copie para `.env` e preencha com valores reais. Nunca commite o `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente e servidor
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Ano padrão das listagens de inscrição (query ?ano= sobrescreve). Opcional.
DEFAULT_EVENT_YEAR=2026
# Data do evento para cálculo de idade na inscrição (YYYY-MM-DD). Opcional.
EVENT_REFERENCE_DATE=2026-07-19

# Inscrições públicas: true = abertas ao público autenticado; false/ausente = encerradas.
# Administradores (role=admin) podem continuar inscrevendo mesmo com false.
PUBLIC_REGISTRATIONS_OPEN=false

# -----------------------------------------------------------------------------
# Banco de dados (Prisma / PostgreSQL)
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# -----------------------------------------------------------------------------
# Autenticação JWT
# -----------------------------------------------------------------------------

JWT_SECRET="change-me-use-a-long-random-string"
JWT_EXPIRATION=2h

# -----------------------------------------------------------------------------
# URLs públicas (CORS e e-mails)
# -----------------------------------------------------------------------------

FRONTEND_URL="https://seu-site.vercel.app"
BASE_URL="https://seu-site.vercel.app"

# -----------------------------------------------------------------------------
# E-mail (Resend) — usar após migração
# -----------------------------------------------------------------------------

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="CONMEL <noreply@seudominio.com>"

# Alias opcional do remetente (mesma função que RESEND_FROM_EMAIL)
RESEND_FROM="noreply@seudominio.com"

# -----------------------------------------------------------------------------
# Mercado Pago
# -----------------------------------------------------------------------------

MERCADOPAGO_ACCESS_TOKEN="APP_USR_xxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="change-me-webhook-hmac-secret"

# -----------------------------------------------------------------------------
# Supabase (opcional / legado)
# -----------------------------------------------------------------------------

SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
